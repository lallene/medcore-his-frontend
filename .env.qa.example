QA_BASE_URL=http://127.0.0.1:4173
# Prefer a current 49fcac8+ API. Stale Docker on :8080 may lack 23F.1 routes.
QA_API_URL=http://127.0.0.1:18082
# PUBLIC_API_URL is build-time (SvelteKit $env/static/public). Bake before preview:
#   PUBLIC_API_URL=$QA_API_URL npm run build
# Or use: npm run test:e2e:scheduling
QA_ADMIN_EMAIL=admin@example.invalid
QA_ADMIN_PASSWORD=replace-with-a-qa-secret
QA_ENVIRONMENT=local
QA_RUN_ID=local-example
QA_SUITE=smoke
